# ============================================================
# Credenciais da API do Trello
# ============================================================
# Como obter (leva ~2 min):
#   1. Acesse https://trello.com/power-ups/admin e crie um Power-Up
#      (qualquer nome, ex: "Meu Agente Kiro").
#   2. Abra o Power-Up > aba "API Key" > gere a API Key.
#   3. Ao lado da key, clique no link "Token" (ou "manually generate a Token"),
#      autorize e copie o Token gerado.
#
# ATENCAO: estes valores dao acesso a sua conta. Trate como senha.
# Nunca faca commit do arquivo .env (ja esta no .gitignore).
# ============================================================

TRELLO_API_KEY=cole_sua_api_key_aqui
TRELLO_TOKEN=cole_seu_token_aqui

# (Opcional) Limite o dashboard a um board especifico pelo ID.
# Deixe em branco para incluir TODOS os seus boards.
TRELLO_BOARD_ID=

# (Opcional) Quantos dias a frente contam como "vencendo em breve" (amarelo).
PRAZO_ALERTA_DIAS=3

# (Opcional) Protege o dashboard publicado no Vercel com uma senha simples.
# Se definida, o acesso exige ?senha=VALOR na URL. Deixe em branco = acesso livre.
DASHBOARD_SENHA=
